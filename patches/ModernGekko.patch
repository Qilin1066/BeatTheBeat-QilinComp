diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1cbef59..113d490 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -115,9 +115,19 @@ if(MODERNGEKKO_ENABLE_DOLPHIN_RUNTIME)
     set(ENABLE_WAYLAND ON CACHE BOOL "" FORCE)
     set(ENABLE_EGL OFF CACHE BOOL "" FORCE)
     set(USE_SYSTEM_SDL3 OFF CACHE BOOL "" FORCE)
-    # SDL bundles its own copy of the macOS hidapi backend
     if(APPLE)
+        # SDL bundles its own copy of the macOS hidapi backend.
         set(SDL_HIDAPI OFF CACHE BOOL "" FORCE)
+        # The vendored MoltenVK provides Vulkan 1.2. Package a caller-pinned 1.3+ release instead.
+        set(USE_BUNDLED_MOLTENVK OFF CACHE BOOL "Build the vendored MoltenVK" FORCE)
+        set(MODERNGEKKO_MOLTENVK_LIBRARY "" CACHE FILEPATH
+            "Optional MoltenVK 1.3+ macOS dylib to copy beside the runner")
+        if(MODERNGEKKO_MOLTENVK_LIBRARY AND
+           (NOT EXISTS "${MODERNGEKKO_MOLTENVK_LIBRARY}" OR
+            IS_DIRECTORY "${MODERNGEKKO_MOLTENVK_LIBRARY}"))
+            message(FATAL_ERROR
+                "MODERNGEKKO_MOLTENVK_LIBRARY must point to a MoltenVK dylib")
+        endif()
     endif()
     set(LINUX_LOCAL_DEV ON CACHE BOOL "" FORCE)
     set(DISTRIBUTOR "ModernGekko" CACHE STRING "" FORCE)
@@ -496,6 +506,13 @@ if(MODERNGEKKO_ENABLE_DOLPHIN_RUNTIME)
         COMMAND ${CMAKE_COMMAND} -E copy_directory
                 "${CMAKE_CURRENT_SOURCE_DIR}/vendor/dolphin/Data/Sys"
                 "$<TARGET_FILE_DIR:moderngekko-run>/Sys")
+    if(APPLE AND MODERNGEKKO_MOLTENVK_LIBRARY)
+        add_custom_command(TARGET moderngekko-run POST_BUILD
+            COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                    "${MODERNGEKKO_MOLTENVK_LIBRARY}"
+                    "$<TARGET_FILE_DIR:moderngekko-run>/libMoltenVK.dylib"
+            VERBATIM)
+    endif()
     if(MODERNGEKKO_DOL_PATCH_MANIFEST)
         add_custom_command(TARGET moderngekko-run POST_BUILD
             COMMAND ${CMAKE_COMMAND} -E make_directory
